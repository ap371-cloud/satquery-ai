SATQUERY_MAX_UPLOAD_MB=250
SATQUERY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional planner bridge (kept internal; UI branding remains SatQuery AI).
# OPENEARTHAGENT_URL=http://127.0.0.1:8010

# Optional pretrained Sentinel-1 flood checkpoint.
# SATQUERY_FLOOD_MODEL_PATH=./models/best_model.pt

# Best-of-breed specialist services. Each runs in its own environment to avoid
# Torch / Transformers / OpenMMLab dependency conflicts.
# services/teochat_service hosts a REAL remote-sensing VLM: the TEOChat
# checkpoint on CUDA (TEOCHAT_ENGINE=teochat) or a CPU-run vision model
# (TEOCHAT_ENGINE=cpu-vlm, default: Qwen/Qwen2-VL-2B-Instruct). The service is
# NEVER described as TEOChat unless the TEOChat model actually answers.
# TEOCHAT_URL=http://127.0.0.1:8021
# TEOCHAT_ENGINE=auto            # auto | teochat | cpu-vlm
# TEOCHAT_CPU_VLM=Qwen/Qwen2-VL-2B-Instruct
# SARCHAT_URL=http://127.0.0.1:8023
# OPENCD_URL=http://127.0.0.1:8022
# SAMGEO_URL=http://127.0.0.1:8000
# LRSVQA_URL=http://127.0.0.1:8024
# TERRAMIND_URL=http://127.0.0.1:8025

# CPU-run VLM inference can take 30-90s; the service timeout is generous.
SATQUERY_VLM_TIMEOUT=180
SATQUERY_TEOCHAT_TIMEOUT=600
SATQUERY_CHANGE_TIMEOUT=240
SATQUERY_SEGMENT_TIMEOUT=240
SAMGEO_CONFIDENCE=0.45
# Reload guarantee in seconds; the suite waits until a service loads one more time.
SATQUERY_VLM_RELOAD_TIMEOUT=900

SATQUERY_LARGE_RSI_THRESHOLD=4096
SATQUERY_FUSION_TIMEOUT=300

# --- Security hardening (see ../.env.example for descriptions) ----------------
SATQUERY_MAX_QUERY_LEN=2000
SATQUERY_MAX_DATASET_IDS=8
SATQUERY_MAX_PLAN_DATASETS=4
SATQUERY_MAX_FILENAME_LEN=120
SATQUERY_PIXEL_SAFETY_LIMIT=120000000
SATQUERY_RATE_UPLOAD=10
SATQUERY_RATE_UPLOAD_WINDOW=300
SATQUERY_RATE_ANALYSES=5
SATQUERY_RATE_ANALYSES_WINDOW=300
SATQUERY_RATE_PLAN=20
SATQUERY_RATE_PLAN_WINDOW=60
SATQUERY_RATE_PARSE=30
SATQUERY_RATE_PARSE_WINDOW=60
SATQUERY_RATE_DEMO=10
SATQUERY_RATE_DEMO_WINDOW=600
SATQUERY_RATE_STATS=60
SATQUERY_RATE_STATS_WINDOW=60
SATQUERY_RATE_DEFAULT=30
SATQUERY_RATE_DEFAULT_WINDOW=60

# Optional shared rate limiting via Upstash Redis REST (zero new pip deps).
# Without these the in-memory fallback applies per container instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional debug flag; only expose /api/v1/ai/free-test in non-production.
# SATQUERY_DEBUG=0

# Gemini free-tier key enables real online vision-language analysis.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# SatQuery AI — environment variable reference
# Copy to .env.local (or set in the Vercel project settings) and fill in values.
# NEVER commit .env.local. This file only documents variable NAMES.
# ---------------------------------------------------------------------------

# --- Backend / API ----------------------------------------------------------
# Comma-separated list of allowed browser origins (production deployment URL).
SATQUERY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Maximum accepted upload size in MiB.
SATQUERY_MAX_UPLOAD_MB=250

# --- AI / Vision (Google AI Studio, free tier) ------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT=90

# --- Storage (optional; without it, data lives in local SQLite/files) -------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=satquery-bucket
# DATABASE_URL=postgresql://user:pass@host/db

# --- Optional flood checkpoint ----------------------------------------------
# SATQUERY_FLOOD_MODEL_PATH=./models/best_model.pt

# --- Optional specialist services (kept internal) ----------------------------
# OPENEARTHAGENT_URL=http://127.0.0.1:8010
# TEOCHAT_URL=http://127.0.0.1:8021
# SARCHAT_URL=http://127.0.0.1:8023
# OPENCD_URL=http://127.0.0.1:8022
# SAMGEO_URL=http://127.0.0.1:8000
# LRSVQA_URL=http://127.0.0.1:8024
# TERRAMIND_URL=http://127.0.0.1:8025

# --- Rate limiting (Upstash Redis REST; optional but recommended in prod) ----
# Without these, a per-instance in-memory fallback applies (not shared across
# Vercel instances).
# UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Per-IP request windows (requests / window seconds):
SATQUERY_RATE_UPLOAD=10
SATQUERY_RATE_UPLOAD_WINDOW=300
SATQUERY_RATE_ANALYSES=5
SATQUERY_RATE_ANALYSES_WINDOW=300
SATQUERY_RATE_PLAN=20
SATQUERY_RATE_PLAN_WINDOW=60
SATQUERY_RATE_PARSE=30
SATQUERY_RATE_PARSE_WINDOW=60
SATQUERY_RATE_DEMO=10
SATQUERY_RATE_DEMO_WINDOW=600
SATQUERY_RATE_STATS=60
SATQUERY_RATE_STATS_WINDOW=60
SATQUERY_RATE_DEFAULT=30
SATQUERY_RATE_DEFAULT_WINDOW=60

# --- Request validation -------------------------------------------------------
SATQUERY_MAX_QUERY_LEN=2000
SATQUERY_MAX_DATASET_IDS=8
SATQUERY_MAX_PLAN_DATASETS=4
SATQUERY_MAX_FILENAME_LEN=120
SATQUERY_PIXEL_SAFETY_LIMIT=120000000

# --- Debug / misc -------------------------------------------------------------
# Set to 1 only in non-production environments to expose /api/v1/ai/free-test.
# SATQUERY_DEBUG=0

# --- Frontend -----------------------------------------------------------------
# VITE_API_BASE=  (empty in dev = Vite proxy; same-origin /api in production)